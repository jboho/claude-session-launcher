<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs to map JIT pages; required for any Electron app under hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- The launcher drives Terminal/iTerm through osascript. Without this the hardened
         runtime blocks Apple Events outright (errAEEventNotPermitted -1743) and the
         consent prompt never appears. See src/main/spawn/macos.ts. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
