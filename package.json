{
  "name": "claude-session-launcher",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A macOS menu-bar widget that launches Claude Code CLI sessions in your terminal with model, permission mode, and effort preselected.",
  "license": "Apache-2.0",
  "author": "Jonathan Boho",
  "repository": "github:jboho/claude-session-launcher",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "pnpm build && tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:signed": "bash scripts/build-signed.sh"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  }
}
