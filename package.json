{
  "name": "claude-session-launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "repository": "github:jboho/claude-picker",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "pnpm build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "pnpm build && electron-builder --mac --dir",
    "dist:mac:dmg": "pnpm build && electron-builder --mac"
  },
  "build": {
    "appId": "com.jboho.claude-launcher",
    "productName": "Claude Launcher",
    "artifactName": "Claude-Launcher-${version}-${arch}.${ext}",
    "publish": { "provider": "github", "owner": "jboho", "repo": "claude-picker" },
    "files": ["dist/**", "package.json"],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
